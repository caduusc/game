# URL do projeto Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable) — vai para o navegador, protegida por RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Conexão Postgres usada SOMENTE no servidor (Route Handlers).
# Use o pooler em modo transação (porta 6543) do Supabase: Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
